{
  "configurations": [
    {
      "name": "PlatformIO",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src",
        "${workspaceFolder}/lib",
        "${workspaceFolder}/.pio/libdeps/esp32-c6-devkitc-1/*",
        "${default}"
      ],
      "defines": [
        "PLATFORMIO=50205",
        "ESP32",
        "ARDUINO_ARCH_ESP32",
        "ESP_PLATFORM"
      ],
      "compilerPath": "${env:HOME}/.platformio/packages/toolchain-xtensa-esp32/bin/xtensa-esp32-elf-gcc",
      "cStandard": "c11",
      "cppStandard": "c++11",
      "intelliSenseMode": "gcc-x64",
      "compileCommands": "${workspaceFolder}/.pio/build/esp32-c6-devkitc-1/compile_commands.json"
    }
  ],
  "version": 4
}